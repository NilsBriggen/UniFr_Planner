{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "degreeSelection": {
      "type": "object",
      "properties": {
        "structureId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "components": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slotId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "programmeId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "variantId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "startSemester": {
                "type": "string",
                "pattern": "^(AS|SS)-20\\d{2}$"
              },
              "recipeVersion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "slotId",
              "programmeId",
              "variantId",
              "startSemester",
              "recipeVersion"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "structureId",
        "components"
      ],
      "additionalProperties": false
    },
    "id": {
      "type": "string",
      "pattern": "^[\\w-]{1,100}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "programme": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "targetEcts": {
      "type": "number",
      "minimum": 1,
      "maximum": 600
    },
    "semesters": {
      "minItems": 1,
      "maxItems": 24,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(AS|SS)-20\\d{2}$"
      }
    },
    "planningSemester": {
      "type": "string",
      "pattern": "^(AS|SS)-20\\d{2}$"
    },
    "activeScenarioId": {
      "type": "string",
      "pattern": "^[\\w-]{1,100}$"
    },
    "scenarios": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[\\w-]{1,100}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "courses": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[\\w-]{1,100}$"
                },
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "titles": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "maxLength": 20
                  },
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  }
                },
                "ects": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 300
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "completed",
                    "current",
                    "planned",
                    "unscheduled"
                  ]
                },
                "semester": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(AS|SS)-20\\d{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "pinned": {
                  "type": "boolean"
                },
                "attendance": {
                  "type": "object",
                  "properties": {
                    "sourceFingerprint": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "excludedMeetingKeys": {
                      "maxItems": 1000,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      }
                    },
                    "provisional": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "required": [
                    "sourceFingerprint",
                    "excludedMeetingKeys",
                    "provisional"
                  ],
                  "additionalProperties": false
                },
                "offering": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "assignments": {
                          "maxItems": 100,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "programme": {
                                "type": "string",
                                "maxLength": 1000
                              },
                              "version": {
                                "type": "string",
                                "maxLength": 200
                              },
                              "paths": {
                                "maxItems": 100,
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "maxLength": 2000
                                }
                              }
                            },
                            "required": [
                              "programme",
                              "version",
                              "paths"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "source_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "terms": {
                          "maxItems": 30,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "maxLength": 30
                          }
                        },
                        "meetings": {
                          "maxItems": 1000,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "starts_at": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "format": "date-time",
                                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "ends_at": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "format": "date-time",
                                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "location": {
                                "type": "string",
                                "maxLength": 2000
                              },
                              "unresolved": {
                                "type": "boolean"
                              },
                              "cancelled": {
                                "type": "boolean"
                              },
                              "recurrence": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "maxLength": 1000
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "excluded_dates": {
                                "maxItems": 1000,
                                "type": "array",
                                "items": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                      "format": "date",
                                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                                    },
                                    {
                                      "type": "string",
                                      "format": "date-time",
                                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                                    }
                                  ]
                                }
                              },
                              "additional_dates": {
                                "maxItems": 1000,
                                "type": "array",
                                "items": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                      "format": "date",
                                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                                    },
                                    {
                                      "type": "string",
                                      "format": "date-time",
                                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                                    }
                                  ]
                                }
                              },
                              "recurrence_id": {
                                "anyOf": [
                                  {
                                    "anyOf": [
                                      {
                                        "type": "string",
                                        "format": "date",
                                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                                      },
                                      {
                                        "type": "string",
                                        "format": "date-time",
                                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                                      }
                                    ]
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "source_uid": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "maxLength": 1000
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "note": {
                                "type": "string",
                                "maxLength": 10000
                              }
                            },
                            "required": [
                              "location",
                              "unresolved",
                              "cancelled",
                              "excluded_dates",
                              "additional_dates",
                              "note"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "meeting_state": {
                          "type": "string",
                          "enum": [
                            "resolved",
                            "unresolved"
                          ]
                        },
                        "source_url": {
                          "type": "string",
                          "maxLength": 2000
                        },
                        "snapshot_id": {
                          "type": "string",
                          "maxLength": 200
                        },
                        "development_fixture": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "source_id",
                        "terms",
                        "meetings",
                        "meeting_state",
                        "source_url",
                        "snapshot_id",
                        "development_fixture"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "code",
                "titles",
                "ects",
                "status",
                "semester",
                "pinned",
                "offering"
              ],
              "additionalProperties": false
            }
          },
          "unavailable": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[\\w-]{1,100}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "start": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                },
                "end": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                }
              },
              "required": [
                "id",
                "label",
                "start",
                "end"
              ],
              "additionalProperties": false
            }
          },
          "travelMinutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 180
          },
          "requirementEvidence": {
            "type": "object",
            "properties": {
              "overrides": {
                "maxItems": 500,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "allocation",
                        "substitution"
                      ]
                    },
                    "courseId": {
                      "type": "string",
                      "pattern": "^[\\w-]{1,100}$"
                    },
                    "nodeId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    }
                  },
                  "required": [
                    "kind",
                    "courseId",
                    "nodeId",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              },
              "completedChecklist": {
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              }
            },
            "required": [
              "overrides",
              "completedChecklist"
            ],
            "additionalProperties": false
          },
          "priorStudy": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[\\w-]{1,100}$"
                },
                "institution": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "period": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "approximateEcts": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 600
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "self_reported",
                    "recognition_pending"
                  ]
                },
                "notes": {
                  "type": "string",
                  "maxLength": 2000
                }
              },
              "required": [
                "id",
                "institution",
                "period",
                "approximateEcts",
                "status",
                "notes"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "courses",
          "unavailable",
          "travelMinutes"
        ],
        "additionalProperties": false
      }
    },
    "requirements": {
      "type": "object",
      "properties": {
        "cohort": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2100
        },
        "templates": {
          "minItems": 1,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "code",
              "version"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "cohort",
        "templates"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "programme",
    "targetEcts",
    "semesters",
    "activeScenarioId",
    "scenarios"
  ],
  "additionalProperties": false
}
