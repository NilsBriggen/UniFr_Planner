{
  "name": "unifr-planner",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=22.12 <27"
  },
  "packageManager": "npm@11.6.0",
  "scripts": {
    "api:generate": "PYTHONPATH=apps/api:packages/ingest/src .venv/bin/python scripts/generate_openapi.py && openapi-typescript apps/web/src/api/openapi.json -o apps/web/src/api/schema.d.ts && prettier --write apps/web/src/api",
    "dev": "npm run dev --workspace @unifr/web",
    "build": "npm run build --workspace @unifr/web",
    "test": "npm run test --workspace @unifr/web",
    "typecheck": "npm run typecheck --workspace @unifr/web",
    "lint": "eslint apps/web",
    "format": "prettier --write apps/web package.json eslint.config.js .github deploy",
    "format:check": "prettier --check apps/web package.json eslint.config.js .github deploy",
    "test:e2e": "npm run test:e2e --workspace @unifr/web --"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "eslint": "9.34.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "typescript-eslint": "8.41.0"
  }
}
