# Copy these names into a root-owned file outside the repository, for example
# /etc/unifr-planner.env (mode 0600). Never commit the populated file.
RELEASE_ID=<full-git-commit-sha>
POSTGRES_USER=unifr
POSTGRES_PASSWORD=
POSTGRES_DB=unifr
UNIFR_ADMIN_TOKEN=
UNIFR_ACCOUNT_ORIGINS=["https://planner.example.org"]
SITE_ADDRESS=planner.example.org
TLS_EMAIL=operator@example.org

# A JSON list. Every source is HTTPS and its reviewed digest remains fixed until
# an operator explicitly updates it after investigating a weekly change alert.
UNIFR_SOURCE_DOCUMENTS=[]

# Optional HTTPS webhook. Leave blank to retain alerts only in the admin status.
UNIFR_ALERT_HOOK=
UNIFR_DATABASE_LIMIT_BYTES=10737418240
UNIFR_DISK_MINIMUM_BYTES=1073741824

HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_BIND=0.0.0.0
HTTPS_PORT=443
