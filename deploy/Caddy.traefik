{
	admin off
	auto_https off
	servers {
		trusted_proxies static {$TRAEFIK_IP}
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}
:8080 {
	route {
		@untrusted not remote_ip {$TRAEFIK_IP}
		respond @untrusted "Forbidden" 403
		header {
			Strict-Transport-Security "max-age=31536000"
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			X-Frame-Options DENY
			Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
			-Server
		}
		handle /api/* {
			@public_catalogue path /api/v1/catalogue/* /api/v1/status/catalogue
			encode @public_catalogue zstd gzip
			reverse_proxy api-proxy:8000 {
				header_up -Forwarded
				header_up X-Forwarded-For {client_ip}
				header_up X-Forwarded-Proto https
			}
		}
		handle {
			reverse_proxy web:8080
		}
	}
}
:8081 {
	respond /health "ok" 200
}
